<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Parity runner launchd job — polls the reporting app every 15 minutes and
  scrapes when there is work (daily grid after 08:00 Prague, or queued custom
  checks). launchd serializes invocations per label, so runs never overlap.

  15 minutes, not 5: every poll queries Postgres, and Neon suspends compute
  after ~5 idle minutes — a 5-minute poll keeps the database awake 24/7 and
  burned the whole monthly compute quota (2026-08-30). The runner also skips
  polling entirely during Prague night hours (see PARITY_QUIET_HOURS in
  run.ts). Custom checks are picked up within ~15 min while the Mac is awake.

  Install (see docs/pricing-runner.md):
    cp scripts/parity-runner/com.bakerhouse.parity-runner.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.bakerhouse.parity-runner.plist
  Logs: ~/Library/Logs/parity-runner.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bakerhouse.parity-runner</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/patriknovak/Claude/baker-house-reporting &amp;&amp; ./node_modules/.bin/tsx scripts/parity-runner/run.ts</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/patriknovak/Library/Logs/parity-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/patriknovak/Library/Logs/parity-runner.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
